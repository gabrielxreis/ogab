# ============================================================
# Variáveis de ambiente da Mariana
# O instalador copia este arquivo para .env. Preencha só o que for usar.
# O .env fica só na sua máquina (fora do git). Nunca compartilhe.
# Escolha UM provedor de email abaixo (e coloque o mesmo em
# channels.email.provider no harvey.local.yaml): gmail (recomendado),
# microsoft ou smtp. Um verificador de email (Reoon/ZeroBounce) é muito
# recomendado; o resto é opcional.
# ============================================================

# ------------------------------------------------------------
# PROVEDOR DE EMAIL: como a Mariana envia e lê as respostas. Escolha um.
#
# Opção A: Gmail / Google Workspace  [RECOMENDADO até ~50 emails frios/dia]
#   provider: gmail no config. Use, de preferência, uma caixa num domínio
#   SECUNDÁRIO só para prospecção, com SPF/DKIM/DMARC configurados.
#   1. Google Cloud Console → novo projeto → ative a Gmail API e a
#      Google Calendar API (a agenda é usada para oferecer horários livres)
#   2. Credenciais → ID do cliente OAuth → tipo "App para computador"
#   3. Cole o ID e o segredo abaixo e rode: mariana gmail auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Opção B: qualquer caixa SMTP + IMAP  [Fastmail, Zoho, senha de app do Workspace]
#   provider: smtp no config. Os IMAP_* usam os valores de SMTP_* se vazios.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Opção C: Microsoft 365 / Outlook  [caixa no Exchange Online]
#   provider: microsoft no config. Entra com OAuth (veja docs/microsoft365.md):
#   1. entra.microsoft.com → App registrations → New registration
#      ("this organizational directory only"; redirect URI na plataforma
#      "Public client/native", valor http://localhost:8766)
#   2. Cole o Application (client) ID e o Directory (tenant) ID abaixo
#   3. Rode: mariana microsoft auth   (depois: mariana microsoft test)
M365_CLIENT_ID=
M365_TENANT_ID=

# Opção D: Instantly, plataforma de email frio  [legado]
# Onde pegar: https://app.instantly.ai → Settings → Integrations → API Keys
# O acesso à API exige o plano Growth ou acima.
INSTANTLY_API_KEY=

# ------------------------------------------------------------
# LinkedIn: sem login. A Mariana escreve e você envia da sua conta.

# ------------------------------------------------------------
# Cloudflare Browser Rendering: leitura profunda de sites  [OPCIONAL]
# Lê sites que dependem de JavaScript no `mariana train`.
# Onde pegar:
#   Account ID: https://dash.cloudflare.com → barra lateral de qualquer zona
#   API Token:  https://dash.cloudflare.com/profile/api-tokens → Create Token
#               → permissão "Browser Rendering: Edit"
# Custo: ~US$ 5/mês no plano pago do Workers (~12.000 páginas).
# Sem isso, a Mariana usa o leitor HTTP próprio (sem JavaScript).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------
# Verificação de email: como a Mariana confirma que o endereço existe antes
# de enviar. Ela aprende o PADRÃO de email de cada empresa e verifica UM
# candidato. Uma chave basta; as duas dão mais cobertura. Sem nenhuma, os
# endereços ficam como "guess" e nunca recebem email.

# Reoon: o melhor plano grátis para email frio (600 verificações/mês).
# Onde pegar: https://reoon.com/email-verifier → cadastro → API
REOON_API_KEY=

# ZeroBounce: 100 grátis/mês. O mais confiável para domínios do Microsoft
# 365 / Google Workspace que aceitam tudo. https://zerobounce.net → API
ZEROBOUNCE_API_KEY=

# Hunter.io: descoberta de email e padrão  [OPCIONAL]
# Grátis: 50 verificações + 25 buscas por domínio/mês. A busca por domínio é
# o jeito mais barato de aprender o padrão de email de uma empresa.
# Onde pegar: https://hunter.io → cadastro → API → API Keys
HUNTER_API_KEY=
# Buscas por domínio por mês. 25 = plano grátis; ajuste se pagar o Hunter.
HUNTER_MONTHLY_SEARCHES=25

# Precleared: checagem de lei por destinatário  [OPCIONAL]
# Só usada com compliance.precleared.enabled: true no config.
# Sem chave: 10 checagens/dia. Chave grátis: 25/dia.
# Onde pegar: https://precleared.dev/get-key
PRECLEARED_API_KEY=

# ------------------------------------------------------------
# DESCOBERTA: onde a Mariana encontra empresas.  [TUDO OPCIONAL]
# A fonte padrão (OpenStreetMap) não precisa de conta:
#     mariana discover
# Todas as opções, com preço, em:
#     mariana discover --providers      (ou a aba Descobrir do painel)
# ------------------------------------------------------------

# DataForSEO: dados de negócios locais e de busca, os mais baratos.
# Onde pegar: https://app.dataforseo.com/api-access
#   A senha da API é gerada lá. NÃO é a senha da sua conta. US$ 1 grátis no
#   cadastro; depósito mínimo de US$ 50 para usar de verdade.
# Custo: US$ 0,372 por 1.000 empresas; US$ 0,0018 por busca.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Preencha com qualquer valor para usar o sandbox grátis (dados fictícios).
DATAFORSEO_SANDBOX=

# Serper.dev: API de busca do Google. Usada na descoberta, nas buscas do
# Scout e no radar de eventos (mariana eventos).
# Onde pegar: https://serper.dev → cadastro → Dashboard → API Key
# Custo: 2.500 buscas grátis, sem cartão. Sem ela, a Mariana usa DuckDuckGo
# e Bing, que limitam muito.
SERPER_API_KEY=

# ------------------------------------------------------------
# WhatsApp Business Cloud API  [OPCIONAL; só para contatos com opt-in]
# Meta for Developers → WhatsApp → API Setup. Use com
# channels.whatsapp.mode: cloud_api. Sem isso, o WhatsApp funciona no modo
# link: a Mariana escreve e você envia do seu WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Um token que você inventa, para o webhook de respostas (precisa de uma URL
# pública para o painel, por exemplo um Cloudflare Tunnel).
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------
# Avisos no celular quando um lead responde  [OPCIONAL]
# App grátis ntfy (ntfy.sh): assine um tópico difícil de adivinhar.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Ou um bot do Telegram (@BotFather) e o ID do seu chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
