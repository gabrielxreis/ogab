<?xml version="1.0" encoding="UTF-8"?>
<!-- Gab Ponte AE: extensão INVISÍVEL que inicia sozinha quando o After Effects abre e recebe os comandos do /ogab
     (servidor local 127.0.0.1:8766, sem internet). Não tem painel: nada para o usuário abrir ou clicar. -->
<ExtensionManifest Version="12.0" ExtensionBundleId="com.gabrielxreis.ogab.aeponte" ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Gab Ponte AE" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.gabrielxreis.ogab.aeponte.servidor" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.gabrielxreis.ogab.aeponte.servidor">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
